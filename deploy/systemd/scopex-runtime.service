[Unit]
Description=ScopeX local Agent Runtime API

[Service]
Type=simple
WorkingDirectory=%h/scopex-releases/current
EnvironmentFile=%h/.config/scopex/runtime.env
# Keep mutable state outside immutable releases. See docs/09 before migrating an existing service.
ExecStart=%h/scopex-releases/current/.venv/bin/python %h/scopex-releases/current/scripts/runtime_api.py --model ${SCOPEX_MODEL} --base-url ${SCOPEX_BASE_URL} --workspace %h/.local/share/scopex/workspace --data-root %h/.local/share/scopex/runtime-api --sandbox-image ${SCOPEX_SANDBOX_IMAGE} --enable-view-image
Restart=on-failure
RestartSec=10
TimeoutStopSec=620
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
