# Copy to ~/.config/scopex/runtime.env and edit for the target Spark host.
SCOPEX_MODEL=qwen3.8-27b-nvfp4
SCOPEX_BASE_URL=http://127.0.0.1:18002/v1
SCOPEX_SANDBOX_IMAGE=scopex-sandbox-analysis:step7

# Complete prompt image limit, not images per tool call.
# Last observed vLLM limit was 4. Change to 12 only after updating vLLM and passing the probe.
SCOPEX_MAX_IMAGES_PER_PROMPT=4

# Business mounts come from config/data-catalog.json; do not override the whole /agent-data root.
# Optional local vLLM API key. Keep secrets on the device, never in Git/offline exports.
# SCOPEX_API_KEY=
