SCOPEX_ROOT=/opt/ScalingRobotics/scopex
SCOPEX_APP_DIR=/opt/ScalingRobotics/scopex/app
SCOPEX_DATA_DIR=/opt/ScalingRobotics/scopex/data
SCOPEX_MODEL_DIR=/opt/ScalingRobotics/scopex/model/Qwen3.8-27B-NVFP4
COWDISINFECT_LOG_DIR=/opt/ScalingRobotics/CowDisinfect/Log
LEFT_CAMERA_DIR=/opt/ScalingRobotics/CowDisinfect/GrabbedImages/LeftCamera
SCOPEX_VPN_INTERFACE=wg0
SCOPEX_IMAGE_LIMIT=12
SCOPEX_COLLECTION_MAX_BYTES=2147483648
SCOPEX_COLLECTION_MAX_FILES=5000
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.08-py3
SCOPEX_RUNTIME_IMAGE=scopex-runtime:2026.09.15
SCOPEX_SANDBOX_IMAGE=scopex-sandbox-analysis:2026.09.15
SCOPEX_API_KEY=

# 牛掉落监控（可选，默认关闭）。置 1 后 start.sh 启用 compose monitor
# profile，需要 COW_FALL_RTSP_URL 与已导入的监控镜像；详见 docs/deployment.md。
SCOPEX_MONITOR_ENABLED=0
SCOPEX_MONITOR_IMAGE=scopex-monitor:2026.09.26
SCOPEX_MONITOR_MODEL_DIR=/opt/ScalingRobotics/scopex/models-monitor
# 完整 RTSP 地址（含凭据），例如经本机 ssh 隧道：
# rtsp://admin:***@127.0.0.1:8554/cam/realmonitor?channel=1&subtype=0
COW_FALL_RTSP_URL=
