[Unit]
Description=ScopeX local Agent Runtime API

[Service]
Type=simple
WorkingDirectory=%h/scopex
EnvironmentFile=%h/.config/scopex/runtime.env
ExecStart=%h/scopex/.venv/bin/python %h/scopex/scripts/runtime_api.py --model ${SCOPEX_MODEL} --base-url ${SCOPEX_BASE_URL} --workspace %h/scopex/.local/workspace --sandbox-image ${SCOPEX_SANDBOX_IMAGE} --data-dir ${SCOPEX_DATA_DIR}:/agent-data --enable-view-image
Restart=on-failure
RestartSec=10
TimeoutStopSec=620
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
