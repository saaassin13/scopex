# Copy to ~/.config/scopex/runtime.env and edit for the target Spark host.
SCOPEX_MODEL=qwen3.8-27b-nvfp4
SCOPEX_BASE_URL=http://127.0.0.1:18002/v1
SCOPEX_SANDBOX_IMAGE=scopex-sandbox-analysis:step7
SCOPEX_DATA_DIR=/path/to/business-data

# Optional local vLLM API key. runtime_api.py reads SCOPEX_API_KEY directly.
# SCOPEX_API_KEY=
